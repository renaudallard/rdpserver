# GNUmakefile -- thin shim for GNU make on Linux.
#
# GNU make reads this file in preference to "Makefile" when both
# exist.  The portable rules live in Makefile; this file just sets
# GNU-make-friendly defaults and includes it.

# bmake's "include" syntax happens to match GNU make's, so the same
# Makefile works under both.  Nothing extra to do for now -- keep
# this file as a hook for future GNU-only conveniences (e.g.
# automatic dependency generation).

include Makefile
